menu "PA Reader"

config PAREADER_PN532_SDA_GPIO
    int "PN532 SDA GPIO"
    default 11

config PAREADER_PN532_SCL_GPIO
    int "PN532 SCL GPIO"
    default 12

config PAREADER_LED_ENABLED
    bool "Enable discrete RGB LED output"
    default n

if PAREADER_LED_ENABLED

config PAREADER_LED_RED_GPIO
    int "Red LED GPIO"
    default 4

config PAREADER_LED_GREEN_GPIO
    int "Green LED GPIO"
    default 5

config PAREADER_LED_BLUE_GPIO
    int "Blue LED GPIO"
    default 6

endif

endmenu
